# auto: use iFinD with an access token (or legacy refresh token); otherwise AkShare
MARKET_DATA_PROVIDER=auto

# Keep the real value in the server environment. Never commit it.
IFIND_ACCESS_TOKEN=

# Legacy compatibility only. New setups should use IFIND_ACCESS_TOKEN.
IFIND_REFRESH_TOKEN=

# Only needed when deliberately running the live integration test.
RUN_IFIND_INTEGRATION=0
